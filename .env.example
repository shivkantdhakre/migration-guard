# MigrationGuard Environment Configuration

# Control Plane Database (PostgreSQL)
# Required in production: must point to a production PostgreSQL database (e.g. Neon)
DATABASE_URL="postgresql://username:password@hostname:5432/migrationguard_control?sslmode=require"

# Redis / BullMQ (e.g. Aiven Valkey or local Redis)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
# REDIS_URL="rediss://default:password@hostname:port"

# Security / Secrets (MANDATORY IN PRODUCTION - DO NOT USE PLACEHOLDERS)
# Generate a cryptographically secure JWT secret (at least 32 characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=""

# Generate a 64-character hex master encryption key for AES-256-GCM vault:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Object Storage / Attachments (MinIO / AWS S3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_ATTACHMENTS="migrationguard-attachments"
S3_BUCKET_REPORTS="migrationguard-reports"
S3_FORCE_PATH_STYLE="true"

# AI Provider Configuration (Optional, core app functions with AI disabled)
AI_PROVIDER="mock" # "mock", "gemini", "openai", "anthropic"
AI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-pro"
AI_TIMEOUT_MS=30000

# Server Ports
PORT=4000
FRONTEND_PORT=3000

# Logging
LOG_LEVEL="info"
LOG_REDACT_KEYS="password,secret,credentials,token,privateKey,connectionString,accessToken,refreshToken"
