# MigrationGuard Environment Configuration

# Control Plane Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres_secret_password@localhost:5432/migrationguard_control?schema=public"

# Redis / BullMQ
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Security / JWT
JWT_SECRET="migrationguard_super_secure_jwt_dev_secret_key_minimum_32_chars!"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" # 32 bytes hex for AES-256-GCM

# MinIO / Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
S3_BUCKET_ATTACHMENTS="migrationguard-attachments"
S3_BUCKET_REPORTS="migrationguard-reports"
S3_FORCE_PATH_STYLE="true"

# AI Provider Configuration (Optional, core app functions with AI disabled)
AI_PROVIDER="mock" # "mock", "gemini", "openai", "anthropic"
AI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-pro"
AI_TIMEOUT_MS=30000

# Server Ports
PORT=4000
FRONTEND_PORT=3000

# Logging
LOG_LEVEL="debug"
LOG_REDACT_KEYS="password,secret,credentials,token,privateKey,connectionString"
