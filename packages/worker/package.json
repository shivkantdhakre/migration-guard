{
  "name": "@migrationguard/worker",
  "version": "0.1.0",
  "description": "MigrationGuard data-plane migration worker and recovery engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/worker-main.js",
    "start:dev": "tsc -p tsconfig.json && node dist/worker-main.js"
  },
  "dependencies": {
    "@migrationguard/core": "workspace:*",
    "bullmq": "^5.41.0",
    "ioredis": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
